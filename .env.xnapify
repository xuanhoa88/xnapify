# ==============================================================================
# xnapify - Environment Configuration
# ==============================================================================
# Copy this file to .env and update the values for your environment
#
# IMPORTANT FOR PRODUCTION:
# - DO NOT deploy .env file to production servers
# - Set environment variables directly on the server instead
# - See DEPLOYMENT.md for production environment variable setup
#
# NAMING CONVENTIONS:
# - XNAPIFY_PUBLIC_ in key name → injected into client bundles (visible to browsers)
# - _KEY suffix → sensitive secret (auto-excluded from ALL bundles)
# - All other XNAPIFY_* vars → server-only (never leaked to client)
# ==============================================================================

# Node Environment: development, test, production
NODE_ENV=production

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------

# Port for the Node.js application server
XNAPIFY_PORT=1337

# Host for development server (localhost, 127.0.0.1, 0.0.0.0, etc.)
# Recommended: 127.0.0.1 (avoids IPv6 delays and connection issues)
XNAPIFY_HOST=127.0.0.1

# Maintenance mode (true/false). When true every request except /api/health
# and /api/ready is answered with 503 E_MAINTENANCE.
XNAPIFY_MAINTENANCE_MODE=false

# Secret that lets an operator through maintenance mode: visit /<token> once
# and the bypass is stored in a cookie for 30 days. Minimum 16 characters
# (enforced in production, and below that the magic link is ignored).
# Treat it as a secret even though the name does not end in _KEY.
XNAPIFY_MAINTENANCE_BYPASS_TOKEN=

# ------------------------------------------------------------------------------
# API Config & Gateway
# ------------------------------------------------------------------------------

# Enable rate limiting for API endpoints (true/false)
XNAPIFY_RATE_LIMIT=

# Rate limit max requests per window per IP (global default; auth routes use stricter per-route limits)
XNAPIFY_RATE_LIMIT_MAX=1000

# Rate limit time window in milliseconds (default 15 minutes = 900000)
XNAPIFY_RATE_LIMIT_WINDOW=900000

# API body parser limits (e.g., '10mb', '50mb')
# Maximum allowed size for JSON payloads
XNAPIFY_JSON_BODY_LIMIT=

# Maximum allowed size for URL-encoded payloads
XNAPIFY_URLENCODED_BODY_LIMIT=

# API CORS Config
# Allowed origins for Cross-Origin Resource Sharing (e.g., 'https://example.com' or '*')
XNAPIFY_CORS_ORIGIN=

# ------------------------------------------------------------------------------
# Application Metadata
# ------------------------------------------------------------------------------

# Application name (used in page titles and default email names)
XNAPIFY_PUBLIC_APP_NAME="xnapify"

# Application description (used in meta tags for SEO)
XNAPIFY_PUBLIC_APP_DESC="Snap your API, Stream your React"

# Full URL where the app is hosted (e.g., https://example.com)
# Used for generating absolute links (e.g., OAuth callbacks, emails)
# NOTE: Auto-derived as XNAPIFY_PUBLIC_APP_URL for client-side use
XNAPIFY_PUBLIC_APP_URL=

# Default application open graph image URL (used for social sharing previews)
XNAPIFY_PUBLIC_APP_IMAGE=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------

# Database connection URL
# Drivers are installed on-demand by preboot.js into .xnapify/sequelize-drivers/<dialect>
# (NOT in package.json, NOT linked into node_modules — npm would prune them).
# Supports full URLs and shorthand values:
#   sqlite                  → SQLite (default)
#   postgres                → auto-resolve: remote → local → embedded PG
#   postgresql://user:pass@host:5432/db → specific PG server
#   mysql                   → auto-resolve: remote → local → embedded MySQL
#   mysql://user:pass@host:3306/db      → MySQL server
#
# Resolution priority chain (for both PostgreSQL and MySQL):
#   1. Configured URL (remote or local) — if reachable, use it
#   2. Local system server (PG: 5432, MySQL: 3306) — if running, auto-switch
#   3. Embedded server (PG: 5433, MySQL: 3307) — auto-downloads portable daemon
#
# Manual control: node tools/npm/preboot.js --start | --stop | --status
# On-demand:     XNAPIFY_DB_TYPE=mysql npm run dev  (updates .env persistently)
XNAPIFY_DB_URL=sqlite:database.sqlite

# Embedded SQLite data directory (default: .xnapify/sqlite in dev, ~/.xnapify/sqlite in prod)
# Override in Docker to a mounted volume (e.g., /app/data/sqlite)
XNAPIFY_SQLITE_DATA_DIR=

# Embedded PostgreSQL data directory (default: ~/.xnapify/postgres)
# Override in Docker to a mounted volume (e.g., /app/data/postgres)
XNAPIFY_PG_DATA_DIR=

# Embedded MySQL data directory (default: ~/.xnapify/mysql in production)
# Override in Docker to a mounted volume (e.g., /app/data/mysql)
XNAPIFY_MYSQL_DATA_DIR=

# Enable database logging for debugging queries (true/false)
XNAPIFY_DB_LOG=false

# Database timezone (e.g., 'UTC', '+07:00', 'local')
XNAPIFY_DB_TZ=UTC

# Sequelize connection pool bounds (defaults: max 5, min 0).
# XNAPIFY_DB_POOL_MIN must not exceed XNAPIFY_DB_POOL_MAX or boot validation fails.
XNAPIFY_DB_POOL_MAX=
XNAPIFY_DB_POOL_MIN=

# ------------------------------------------------------------------------------
# Queue Configuration
# ------------------------------------------------------------------------------

# Default queue adapter for channels that don't name one:
#   file    → persistent, survives restarts, safe across processes sharing the data dir (default)
#   memory  → in-process only; every queued job is lost when the app exits
XNAPIFY_QUEUE_TYPE=file

# File queue data directory (default: .xnapify/queues in dev, OS data dir in prod)
# Override in Docker to a mounted volume (e.g., /app/data/queues)
XNAPIFY_QUEUE_DATA_DIR=

# ------------------------------------------------------------------------------
# Authentication, Users & JWT
# ------------------------------------------------------------------------------

# JWT secret key for token signing
# IMPORTANT: Must be at least 32 characters. Auto-generated on first run.
# Generate manually: openssl rand -base64 32
# CONVENTION: All secrets/credentials MUST end with _KEY (auto-excluded from client bundles).
XNAPIFY_KEY=

# Previous JWT secret — used during key rotation to verify tokens signed
# with the old key. Remove after all old tokens have expired.
XNAPIFY_PREV_KEY=

# JWT token expiration time
# Examples: '60s', '5m', '2h', '7d'
XNAPIFY_JWT_EXPIRY=7d

# Max-age of the refresh_token cookie (default '30d', examples: '12h', '30d').
# This controls how long the browser keeps the cookie, not the token's own
# `exp` — that is fixed at 30d by JWT_TOKEN_TYPES in shared/jwt/constants.js,
# so a longer value here does not extend the session.
XNAPIFY_JWT_REFRESH_EXPIRY=30d

# Configure the maximum allowed cookie size in bytes
XNAPIFY_COOKIE_MAX_SIZE=4096

# Advanced JWT Config
# Algorithm used for signing (e.g., 'HS256', 'RS256')
XNAPIFY_JWT_ALG=HS256
# Expected audience (Optional)
XNAPIFY_JWT_AUD=
# Expected issuer (Optional)
XNAPIFY_JWT_ISS=

# User Settings
# Default URL to fallback to if a user has no avatar assigned
XNAPIFY_AVATAR_DEFAULT_URL=
# Maximum file size (in bytes) allowed for avatar uploads
XNAPIFY_AVATAR_MAX_SIZE=

# --- OAuth Providers ---
# To enable an OAuth provider, fill in both Client ID and Key for that provider.
# CONVENTION: All secrets/credentials MUST end with _KEY (auto-excluded from client bundles).

# Google Integration
XNAPIFY_GOOGLE_CLIENT_ID=
XNAPIFY_GOOGLE_CLIENT_KEY=

# Facebook Integration
XNAPIFY_FACEBOOK_APP_ID=
XNAPIFY_FACEBOOK_APP_KEY=

# GitHub Integration
XNAPIFY_GITHUB_CLIENT_ID=
XNAPIFY_GITHUB_CLIENT_KEY=

# Microsoft Integration
XNAPIFY_MICROSOFT_CLIENT_ID=
XNAPIFY_MICROSOFT_CLIENT_KEY=

# ------------------------------------------------------------------------------
# File System (FS) & Uploads
# ------------------------------------------------------------------------------

# General FS configs
# Name of the root upload directory (relative to the project or absolute path)
XNAPIFY_UPLOAD_DIR=
# Global maximum file size allowed for generic uploads (in bytes)
XNAPIFY_UPLOAD_FILE_SIZE=
# Maximum allowed characters for uploaded file names
XNAPIFY_UPLOAD_FILE_LENGTH=
# Comma-separated list of globally allowed file extensions (e.g., '.jpg,.png,.pdf')
XNAPIFY_UPLOAD_FILE_EXT=

# Specific Directories & Limits
# Directory for saving system/user archives or backups
XNAPIFY_UPLOAD_ARCHIVE_DIR=
# Maximum archive size (in bytes)
XNAPIFY_UPLOAD_ARCHIVE_MAX=

# Dedicated directory for user avatars
XNAPIFY_UPLOAD_AVATAR_DIR=
# Specific maximum size for avatar files (overrides general max size)
XNAPIFY_UPLOAD_AVATAR_MAX=

# Dedicated directory for document uploads (PDFs, docs, etc.)
XNAPIFY_UPLOAD_DOC_DIR=
# Specific maximum size for document files
XNAPIFY_UPLOAD_DOC_MAX=

# General miscellaneous files directory
XNAPIFY_UPLOAD_GENERAL_DIR=
XNAPIFY_UPLOAD_GENERAL_MAX=

# Directory for heavy media files (audio/video)
XNAPIFY_UPLOAD_MEDIA_DIR=
# Specific maximum size for media files
XNAPIFY_UPLOAD_MEDIA_MAX=

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------

# Provider: 'smtp', 'mailgun', 'sendgrid', 'resend', or 'mock'
XNAPIFY_MAIL_PROVIDER=smtp

# Default sender details used if not explicitly passed during send
XNAPIFY_MAIL_FROM="no-reply@example.com"

# Email Worker Configs (For background mailing processes)
# Maximum number of concurrent email worker processes
XNAPIFY_MAIL_WORKERS=
# Maximum requests a worker handles before restarting (prevents memory leak)
XNAPIFY_MAIL_WORKER_MAX_REQ=
# Time limit (ms) a worker is allowed to process a request before failing
XNAPIFY_MAIL_WORKER_TIMEOUT=

# SMTP Config (Used if XNAPIFY_MAIL_PROVIDER is 'smtp')
# Address of SMTP server (e.g., 'smtp.mailtrap.io')
XNAPIFY_SMTP_HOST=
# Port of SMTP server (e.g., 587 or 465)
XNAPIFY_SMTP_PORT=
# SMTP username
XNAPIFY_SMTP_USER=
# SMTP password
XNAPIFY_SMTP_KEY=
# Use TLS/SSL (true/false)
XNAPIFY_SMTP_SECURE=false

# Mailgun Config (Used if XNAPIFY_MAIL_PROVIDER is 'mailgun')
XNAPIFY_MAILGUN_KEY=
XNAPIFY_MAILGUN_DOMAIN=
XNAPIFY_MAILGUN_REGION=

# Sendgrid Config (Used if XNAPIFY_MAIL_PROVIDER is 'sendgrid')
XNAPIFY_SENDGRID_KEY=

# ------------------------------------------------------------------------------
# Search Engine, Extensions & Node-RED
# ------------------------------------------------------------------------------

# Search Engine adapter type (default: 'database')
# Uses native FTS: SQLite FTS5, PostgreSQL tsvector, MySQL FULLTEXT
# Extensions can register custom adapters (e.g., 'elasticsearch', 'meilisearch')
# and override this value, or set programmatically via container.instance('search:type', '...')
XNAPIFY_SEARCH_TYPE=

# Webhooks key (if used to secure incoming/outgoing webhooks)
XNAPIFY_WEBHOOK_KEY=

# Extension Configuration
# System-wide or built-in extensions path
XNAPIFY_EXTENSION_DIR=
# Path for user-installed or custom local extensions relative to project root
XNAPIFY_EXTENSION_LOCAL_PATH=extensions

# Extensions the operator trusts with the "*" capability (comma-separated
# extension ids or package names). An extension's own package.json cannot
# grant itself "*" — only this list can. Everything else stays on its declared
# capabilities plus the side-effect-free defaults. `extension`, `jwt` and `env`
# are never granted, not even here.
# The same list also unlocks the privileged tier (`db`, `models`, `worker`,
# `queue`, `schedule`, `fs`, `redis`) for a hub-installed extension. Extensions
# bundled in src/extensions/ already have it — they ship with the build.
XNAPIFY_TRUSTED_EXTENSIONS=

# Extension Hub Registry
# URL to the GitHub-hosted registry.json (entry point for browsing public extensions)
# Example: https://raw.githubusercontent.com/xuanhoa88/xnapify-extension-hub/main/registry.json
XNAPIFY_HUB_REGISTRY_URL=

# Node-RED Integration configuration
# Node-RED user data directory (default: ~/.xnapify/node-red)
XNAPIFY_NODERED_HOME=
# Enable Node-RED's built-in projects feature (true/false)
XNAPIFY_NODERED_PROJECTS=false
# Node-RED specific log level ('fatal', 'error', 'warn', 'info', 'debug', 'trace')
XNAPIFY_NODERED_LOG_LEVEL=info

# File cache directory (default: ~/.xnapify/caches)
XNAPIFY_CACHE_DIR=

# Modules features flags
# Comma-separated list or JSON-string defining active module toggles
XNAPIFY_MODULE_DEFAULTS=

# ------------------------------------------------------------------------------
# Optimization & Performance
# ------------------------------------------------------------------------------

# Enable HTTP compression (true/false)
XNAPIFY_COMPRESSION=true

# Compression level (1-9), where 9 is max compression but slower
XNAPIFY_COMPRESSION_LEVEL=6

# Enable Server-Side Rendering (SSR) Cache (true/false)
XNAPIFY_SSR_CACHE=false

# SSR Cache Time-To-Live in milliseconds (default 60 seconds)
XNAPIFY_SSR_CACHE_TTL=60000

# Byte budget for the SSR HTML cache per process (default 64 MB). Entries
# are evicted by size and TTL so cached pages can never grow the heap unbounded.
XNAPIFY_SSR_CACHE_MAX_BYTES=

# How long (ms) a successfully verified JWT stays in the in-memory verification
# cache (default 60000). Capped by the token's own `exp`.
# RENAMED: this used to be read from XNAPIFY_SSR_CACHE_TTL. If you tuned that
# key for JWT verification, move the value here — XNAPIFY_SSR_CACHE_TTL now
# only controls the SSR HTML cache.
XNAPIFY_JWT_CACHE_TTL=

# How long (ms) a token that failed verification is rejected without being
# re-verified (default 30000). Protects the API from garbage-token floods.
XNAPIFY_JWT_NEGATIVE_CACHE_TTL=

# Worker processes: 1 (default, single process), a number, or "auto" (one per
# CPU). Cluster mode disables Node-RED, which is a single-process runtime;
# cron schedules run only on worker 0.
#
# Clustering (> 1) is validated at boot and REFUSED in production unless:
#   - XNAPIFY_REDIS_URL is set (shared cache, rate limits, revocation, WS), and
#   - XNAPIFY_DB_URL is postgres: or mysql: — SQLite has no cross-process
#     schema lock, so workers would race each other's migrations, and
#   - XNAPIFY_DB_POOL_MAX is at least 2 — the schema lock is held on its own
#     pooled connection while migrations run on another.
XNAPIFY_CLUSTER_WORKERS=

# Set by the cluster primary on each fork; workers read it back as the
# authoritative worker count. Leave blank — it is not meant to be set by hand.
XNAPIFY_CLUSTER_SIZE=

# Embedded Node-RED runtime and editor (default true; forced off in cluster mode)
XNAPIFY_NODERED_ENABLED=

# Shared backend for multi-process / multi-instance deployments. When set, the
# cache, rate-limit counters, session revocation store and WebSocket channels
# live in Redis instead of each worker's memory. Required when
# XNAPIFY_CLUSTER_WORKERS > 1. Example: redis://127.0.0.1:6379/0
XNAPIFY_REDIS_URL=
# Key namespace so several deployments can share one Redis (default xnapify)
XNAPIFY_REDIS_PREFIX=

# Declares that TLS is terminated in front of this process (true/false).
# HSTS and CSP's `upgrade-insecure-requests` are emitted on the strength of
# this flag, not of NODE_ENV. Browsers honour upgrade-insecure-requests even
# on plain HTTP, so asserting it on a non-TLS deployment upgrades every
# subresource to https:// against a port with no TLS and the page renders
# blank. Leave unset/false for plain-HTTP or internal deployments.
XNAPIFY_TLS_TERMINATED=

# Brotli quality for build-time precompressed assets (0-11, default 10).
# 11 is ~2% smaller but roughly doubles the compression step of the build.
XNAPIFY_PRECOMPRESS_BROTLI_QUALITY=

# Locale Cache Configuration
# Max number of locale dictionaries cached in memory
XNAPIFY_I18N_CACHE_MAX=500
# Duration (in ms) to hold locale data in memory before clearing
XNAPIFY_I18N_CACHE_TTL=60000

# I18n debug logging
# Outputs verbose log of i18n translation misses or loads (true/false)
XNAPIFY_I18N_DEBUG=false

# ------------------------------------------------------------------------------
# Testing & Benchmarks
# ------------------------------------------------------------------------------

# -- Testing (Jest) Configuration --
# CI environment flag (true/false, default: false)
# CI=false
# Run tests with coverage (true/false)
# JEST_COVERAGE=false
# Run tests in watch mode (true/false)
# JEST_WATCH=false
# Enable verbose test output (true/false, default: true)
# JEST_VERBOSE=true
# Run benchmarks instead of unit tests (true/false)
# JEST_BENCHMARK=false
# Max workers (number or percentage, e.g., '2' or '50%')
# JEST_MAX_WORKERS=

# -- Benchmarking Configuration --
# Used when running stress tests or benchmarks
# Number of concurrent benchmarking clients
# BENCH_CONCURRENCY=200
# Number of handlers instantiated
# BENCH_HANDLERS=50
# Simulated blocking IO time directly inside the benchmark processes
# BENCH_IO_MS=0
# Simulated payload size (in bytes) sent
# BENCH_PAYLOAD_BYTES=256
# Target extension to stress test
# BENCH_EXTENSION_ID=stress-extension
# Record execution paths (true/path string or empty)
# BENCH_RECORD=
# Number of total requests simulated during bench
# BENCH_REQUESTS=1000

# ------------------------------------------------------------------------------
# Development / Logging / Build Server Configuration
# ------------------------------------------------------------------------------

# -- Rspack Configuration --
# Source maps configuration tailored for Rspack
# e.g., 'source-map', 'eval-source-map', 'hidden-source-map', or 'false'
# RSPACK_DEVTOOL=

# -- Cleanup Task Configuration --
# Deep clean node modules and locks (true/false, default: false)
# CLEAN_DEEP=false
# Perform a dry run of the clean command, logging what would be deleted without actually deleting (true/false)
# CLEAN_DRY_RUN=false
# Preserve .git directory during clean (true/false, default: true)
# CLEAN_PRESERVE_GIT=true
# Maximum age of test-reports in milliseconds before they are cleaned (default 7 days = 604800000)
# CLEAN_MAX_AGE=604800000

# Project root directory override (defaults to process.cwd())
# CWD=

# Build output directory (defaults to 'build')
# BUILD_DIR=build

# Application source directory (defaults to 'src')
# APP_DIR=src

# Public static assets directory (defaults to 'public')
# PUBLIC_DIR=public

# Maximum bundle asset size warning limit in bytes (defaults to 250000 = 250KB)
# RSPACK_MAX_ASSET_SIZE=250000

# Open browser automatically on dev server start (true/false)
# Defaults to true unless in CI environment or silent mode
OPEN_BROWSER=false

# Logging configuration
# Global log level output ('silent', 'error', 'warn', 'info', 'verbose', 'debug')
LOG_LEVEL=info
# Flag to strictly silence terminal output (equivalent to LOG_LEVEL=silent)
LOG_SILENT=false
# Flag to allow verbose output (equivalent to LOG_LEVEL=verbose)
LOG_VERBOSE=true

# Enable bundle analysis
# Analyzes the rspack dependency graph for optimization
# RSPACK_ANALYZE=false

# Enable build profiling
# Emits a JSON file that can be inspected inside Chrome devtools performance tab
# RSPACK_PROFILE=false
